{
  "name": "cartaya",
  "version": "0.1.0",
  "private": true,
  "description": "Carta digital de La Estación",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",

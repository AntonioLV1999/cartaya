  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
